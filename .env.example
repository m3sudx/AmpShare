# AMPSHARE - ENVIRONMENT CONFIGURATION TEMPLATE

# 1. Database Configuration (PostgreSQL 16 with PostGIS)
POSTGRES_DB=ampshare
POSTGRES_USER=ampshare
POSTGRES_PASSWORD=replace_with_your_own_local_dev_password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ampshare
DB_USER=ampshare
DB_PASSWORD=replace_with_your_own_local_dev_password

# 2. Server API Configuration
PORT=3003
NODE_ENV=development

# 3. Authentication & Security
JWT_SECRET=ampshare_local_development_secret_key_12345
JWT_EXPIRES_IN=7d

# 4. Payment Gateway Configuration (ePay Ethiopia / Telebirr Direct Payment)
# Keep EPAY_MOCK=true for local development and integration tests without live gateway credentials.
# Set EPAY_MOCK=false and provide live merchant credentials for production.
EPAY_MOCK=true
EPAY_API_BASE_URL=https://api.epayethiopia.com/v1
EPAY_SECRET_KEY=your_epay_ethiopia_secret_key
EPAY_WEBHOOK_SECRET=your_epay_ethiopia_webhook_signing_secret
