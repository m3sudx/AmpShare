# AMPSHARE SERVER - ENVIRONMENT CONFIGURATION TEMPLATE

# Server Port
PORT=3003
NODE_ENV=development

# Database Configuration (PostgreSQL 16 with PostGIS)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ampshare
DB_USER=ampshare
DB_PASSWORD=replace_with_your_own_local_dev_password

# JWT Authentication
JWT_SECRET=ampshare_local_development_secret_key_12345
JWT_EXPIRES_IN=7d

# Payment Gateway Configuration (ePay Ethiopia / Telebirr Direct Payment)
# Set EPAY_MOCK=true for local development/testing without real merchant credentials.
# Set EPAY_MOCK=false and provide credentials for production payments.
EPAY_MOCK=true
EPAY_API_BASE_URL=https://api.epayethiopia.com/v1
EPAY_SECRET_KEY=mock_secret_key_development_only
EPAY_WEBHOOK_SECRET=mock_webhook_secret_development_only
